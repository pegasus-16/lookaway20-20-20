{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMS activity or agent-session event",
  "type": "object",
  "required": ["event_id", "timestamp", "actor", "actor_type", "event_type", "summary"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1 },
    "actor_type": { "type": "string", "enum": ["Human", "AI agent", "Automated system"] },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "session_started", "session_completed", "task_created", "task_updated",
        "implementation_started", "implementation_completed", "test_passed",
        "test_failed", "decision_proposed", "decision_accepted",
        "decision_rejected", "approval_requested", "approval_received",
        "blocker_identified", "handoff_created", "documentation_updated",
        "correction_recorded"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "affected_files": { "type": "array", "items": { "type": "string" } },
    "related_commit": { "type": "string" },
    "test_results": { "type": "object" },
    "verification_level": {
      "type": "string",
      "enum": ["Implemented", "Tested", "Device verified", "Released", "Unverified"]
    },
    "approval_reference": { "type": "string" },
    "related_event_ids": { "type": "array", "items": { "type": "string" } },
    "reporting_source": { "type": "string" }
  },
  "additionalProperties": false
}
