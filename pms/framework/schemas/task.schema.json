{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMS task",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "description",
    "parent_task",
    "milestone",
    "priority",
    "status",
    "assignee",
    "created_at",
    "updated_at",
    "dependencies",
    "related_decisions",
    "files_affected",
    "acceptance_criteria",
    "test_requirements",
    "verification_evidence",
    "outstanding_issues"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "parent_task": { "type": ["string", "null"] },
    "milestone": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
    "status": {
      "type": "string",
      "enum": ["Proposed", "Planned", "In progress", "Implemented", "Tested", "Device verified", "Released", "Blocked", "Cancelled"]
    },
    "assignee": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "related_decisions": { "type": "array", "items": { "type": "string" } },
    "files_affected": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "test_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verification_evidence": { "type": "array", "items": { "type": "string" } },
    "outstanding_issues": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
